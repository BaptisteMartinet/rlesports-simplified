{
  "name": "rlesports-simplified",
  "version": "0.1.0",
  "private": true,
  "description": "Instagram bot posting simple RLCS updates for new Rocket League esports fans",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data:check": "tsx src/scripts/check-data.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "preview": "tsx src/scripts/preview.ts",
    "dry-run": "DRY_RUN=1 tsx src/index.ts",
    "start": "tsx src/index.ts",
    "check:accounts": "tsx src/scripts/check-accounts.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
